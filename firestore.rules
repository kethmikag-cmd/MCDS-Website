rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────
    // Returns true if the request is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the authenticated user owns the school document.
    function isOwningCoordinator(resource) {
      return isAuthenticated() && resource.data.firebaseUID == request.auth.uid;
    }

    // Returns true if the authenticated user is a registered administrator.
    // This is verified by checking for a document in the admins collection
    // whose ID matches the authenticated Firebase UID.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Registrations collection ──────────────────────────────────────────────
    // Anyone can create a registration (public contest entry form).
    // Only authenticated users can read, update, or delete entries.
    match /registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // ── Stats collection ──────────────────────────────────────────────────────
    // Publicly readable (displayed on homepage).
    // Publicly writable for atomic counter increments during registration.
    match /stats/{docId} {
      allow read, write: if true;
    }

    // ── Schools collection ────────────────────────────────────────────────────
    //
    // LIST (collection query): Allowed publicly so that the registration form
    //   can query for duplicate school names BEFORE a Firebase Auth account
    //   has been created. The query only checks normalizedSchoolName; no
    //   sensitive data is returned at this step.
    //
    // GET (single document read): Requires the owning coordinator, OR an admin.
    //
    // CREATE: Requires authentication AND the document's firebaseUID must
    //   match the authenticated user's UID.
    //
    // UPDATE: Only the owning coordinator.
    //
    // DELETE: Only admins may delete school documents.
    match /schools/{schoolId} {
      allow list:   if true;

      allow get:    if isOwningCoordinator(resource) || isAdmin();

      allow create: if isAuthenticated()
                    && request.resource.data.firebaseUID == request.auth.uid;

      allow update: if isOwningCoordinator(resource);

      allow delete: if isAdmin();
    }

    // ── Contestants collection ────────────────────────────────────────────────
    // Only authenticated coordinators (via dashboard) and admins may read/write.
    // Coordinators may create and read their own contestants.
    // Admins have full read/write access.
    match /contestants/{contestantId} {
      allow read:  if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Admins collection ─────────────────────────────────────────────────────
    // Only admins may read the admins collection.
    // Admins cannot be created or modified through the client SDK.
    // Admin accounts must be provisioned directly in the Firebase Console.
    match /admins/{adminId} {
      allow read:             if isAuthenticated() && request.auth.uid == adminId;
      allow create, update, delete: if false;
    }
  }
}
